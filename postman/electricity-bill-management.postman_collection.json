    {
      "name": "2. Customer Management",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consumerNumber\": \"CON-TEST-\" + Math.floor(Math.random() * 90000 + 10000),\n  \"fullName\": \"Postman Test Consumer\",\n  \"email\": \"postman.test@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"address\": \"123 Academic Colony, Tech Campus\",\n  \"connectionType\": \"RESIDENTIAL\",\n  \"registrationDate\": \"2026-10-24\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomCon = 'CON-' + Math.floor(Math.random() * 900000 + 100000);",
                  "pm.environment.set('newConsumerNumber', randomCon);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test(\"Customer ID captured\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.environment.set(\"customerId\", json.data.id);",
                  "    pm.environment.set(\"consumerNumber\", json.data.consumerNumber);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
