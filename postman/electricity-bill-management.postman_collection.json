      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns dashboard metrics\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.have.property('totalActiveCustomers');",
                  "    pm.expect(json.data).to.have.property('totalBilledAmount');",
                  "});"
                ],
                "type": "text/javascript"
              }
